{
  "name": "lumen-reader",
  "productName": "Lumen Reader",
  "version": "1.0.0",
  "description": "A beautiful, fast ebook reader for EPUB, PDF, MOBI/AZW3, FB2 and CBZ with an offline dictionary.",
  "author": {
    "name": "Lumen Reader",
    "email": "maintainer@example.com"
  },
  "homepage": "https://example.com/lumen-reader",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dict": "node scripts/build-dictionary.mjs",
    "predev": "node scripts/prepare.mjs",
    "dev": "vite",
    "prebuild": "node scripts/prepare.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "electron:dev": "concurrently -k -n vite,electron \"vite --strictPort\" \"wait-on tcp:5173 && cross-env ELECTRON_DEV_URL=http://localhost:5173 electron .\"",
    "electron:start": "npm run build && electron .",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && node scripts/gradle.mjs assembleDebug",
    "android:release": "npm run android:sync && node scripts/gradle.mjs assembleRelease",
    "test:e2e": "npm run build && node tests/smoke.mjs && node tests/sync.mjs && node tests/dotion.mjs && node tests/pdf.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "lucide-react": "^1.59.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cmu-pronouncing-dictionary": "^3.0.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1",
    "websters-english-dictionary": "^2.0.0",
    "wndb-with-exceptions": "^3.0.2",
    "wordnet-db": "^3.1.14"
  }
}
